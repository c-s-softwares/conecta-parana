generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-arm64-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

model HealthCheck {
  id        String                                @id
  status    String
  checkedAt DateTime                              @default(now()) @map("checked_at")
  location  Unsupported("geometry(Point, 4326)")?

  @@map("health_checks")
}

model City {
  id        String    @id
  name      String
  state     String    @db.VarChar(2)
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  users        User[]
  events       Event[]
  news         News[]
  locals       Local[]
  communicates Communicate[]
  suggestions  Suggestion[]
  tickets      Ticket[]

  @@unique([name, state])
  @@map("cities")
}

model User {
  id       String  @id
  name     String
  email    String  @unique
  password String
  role     Role    @default(CIDADAO)
  cityId   String? @map("city_id")
  // TODO: descomentar quando o upload de avatar do cidadao for ativado no app mobile.
  // avatarUrl String? @map("avatar_url")
  // avatarThumbUrl String? @map("avatar_thumb_url")

  city                 City?               @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  refresh_tokens       RefreshToken[]
  passwordResetCodes   PasswordResetCode[]
  events               Event[]
  photos               Photo[]
  likes                Like[]
  favorites            Favorite[]
  notifications        Notification[]
  suggestions          Suggestion[]        @relation("UserSuggestions")
  respondedSuggestions Suggestion[]        @relation("ResponderSuggestions")
  locals               Local[]
  communicates         Communicate[]
  tickets              Ticket[]       @relation("UserTickets")
  assignedTickets      Ticket[]       @relation("AssignedTickets")
  comments             TicketComment[]

  @@map("users")
}

enum Role {
  ADMIN
  CIDADAO
}

model RefreshToken {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  userId    String   @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordResetCode {
  id        String    @id
  userId    String    @map("user_id")
  codeHash  String    @unique @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_codes")
}

model Event {
  id          String                                @id
  title       String
  description String
  type        String
  status      String
  coordinates Unsupported("geometry(Point, 4326)")?
  eventDate   DateTime                              @map("event_date")

  cityId  String  @map("city_id")
  userId  String  @map("user_id")
  localId String? @map("local_id")

  city  City   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  local Local? @relation(fields: [localId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  photos        Photo[]
  likes         Like[]
  favorites     Favorite[]
  notifications Notification[]

  @@index([coordinates], type: Gist)
  @@map("events")
}

model Photo {
  id       String  @id
  url      String  @unique
  thumbUrl String? @map("thumb_url")

  eventId  String? @map("event_id")
  userId   String  @map("user_id")
  localId  String? @map("local_id")
  ticketId String? @map("ticket_id")

  event  Event?  @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  local  Local?  @relation(fields: [localId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("photos")
}

model Like {
  id String @id

  userId        String  @map("user_id")
  eventId       String? @map("event_id")
  communicateId String? @map("communicate_id")
  newsId        String? @map("news_id")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       Event?       @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  communicate Communicate? @relation(fields: [communicateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  news        News?        @relation(fields: [newsId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("likes")
}

model Favorite {
  id        String   @id
  createdAt DateTime @default(now()) @map("created_at")

  userId        String  @map("user_id")
  eventId       String? @map("event_id")
  communicateId String? @map("communicate_id")
  newsId        String? @map("news_id")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       Event?       @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  communicate Communicate? @relation(fields: [communicateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  news        News?        @relation(fields: [newsId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("favorites")
}

model Notification {
  id          String  @id
  title       String
  description String
  isRead      Boolean @default(false) @map("is_read")

  userId        String  @map("user_id")
  eventId       String? @map("event_id")
  communicateId String? @map("communicate_id")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       Event?       @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  communicate Communicate? @relation(fields: [communicateId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("notifications")
}

model News {
  id          String  @id
  title       String
  description String
  type        String
  linkType    String  @map("link_type")
  isActive    Boolean @map("is_active")
  cityId      String  @map("city_id")

  city      City       @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  favorites Favorite[]
  likes     Like[]

  @@map("news")
}

model Communicate {
  id          String  @id
  title       String
  description String
  isActive    Boolean @map("is_active")
  cityId      String  @map("city_id")
  userId      String  @map("user_id")

  city City @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  favorites     Favorite[]
  notifications Notification[]
  likes         Like[]

  @@map("communicates")
}

model Category {
  id   String @id
  name String
  icon String

  locals Local[]

  @@map("categories")
}

model Local {
  id          String                                @id
  name        String
  description String
  address     String
  phone       String
  coordinates Unsupported("geometry(Point, 4326)")?
  cityId      String                                @map("city_id")
  categoryId  String                                @map("category_id")
  userId      String                                @map("created_by_user_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  city     City     @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  photos Photo[]
  events Event[]

  @@index([coordinates], type: Gist)
  @@map("locals")
}

model Suggestion {
  id            String    @id
  subject       String
  message       String
  status        String    @default("enviada")
  userId        String    @map("user_id")
  cityId        String    @map("city_id")
  response      String?
  respondedAt   DateTime? @map("responded_at")
  respondedById String?   @map("responded_by_id")

  user        User  @relation("UserSuggestions", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  respondedBy User? @relation("ResponderSuggestions", fields: [respondedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  city        City  @relation(fields: [cityId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("suggestions")
}

model Ticket {
  id           String                               @id
  type         String                               // acidente, sinalização, iluminação, lixo, outros
  title        String
  description  String
  status       String                               @default("aberto") // aberto, em_analise, resolvido, fechado, reaberto
  coordinates  Unsupported("geometry(Point, 4326)")?
  address      String?
  cityId       String                               @map("city_id")
  userId       String                               @map("user_id")
  assignedToId String?                              @map("assigned_to_id")
  createdAt    DateTime                             @default(now()) @map("created_at")
  updatedAt    DateTime                             @updatedAt @map("updated_at")
  resolvedAt   DateTime?                            @map("resolved_at")

  city       City            @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user       User            @relation("UserTickets", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedTo User?           @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  comments   TicketComment[]
  photos     Photo[]

  @@index([coordinates], type: Gist)
  @@map("tickets")
}

model TicketComment {
  id         String   @id
  ticketId   String   @map("ticket_id")
  authorId   String   @map("author_id")
  message    String
  createdAt  DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("ticket_comments")
}
