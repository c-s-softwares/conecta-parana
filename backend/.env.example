# Database
DATABASE_URL=postgresql://user:password@localhost:5432/conecta_parana?schema=public

# Server
PORT=3000
NODE_ENV=development

# Security
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
CORS_ORIGIN=http://localhost:4200,https://admin.conecta.com,https://app.conecta.com,http://localhost:3000

# Redis (cache)
REDIS_URL=redis://localhost:6379

# GlitchTip — APM / Error Tracking
# DSN gerado no dashboard do GlitchTip (ver docs/GLITCHTIP_SETUP.md)
GLITCHTIP_DSN=

# Secrets
JWT_SECRET=minha_chave_secreta_local
JWT_REFRESH_SECRET=minha_chave_refresh_local

# Seed de super admin (usado em backend/prisma/seed-admin.ts)
ADMIN_SEED_EMAIL=admin@conecta.local
ADMIN_SEED_PASSWORD=admin123
ADMIN_SEED_NAME=Admin

# Oracle Object Storage
# Provisionamento: docs/SETUP.md secao "Object Storage Oracle"
OCI_OBJECT_STORAGE_NAMESPACE=grxxxxxxxxxx
OCI_BUCKET_NAME=conecta-parana-photos-staging
OCI_REGION=sa-saopaulo-1
OCI_TENANCY_OCID=ocid1.tenancy.oc1..xxxxx
OCI_USER_OCID=ocid1.user.oc1..xxxxx
OCI_FINGERPRINT=00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00
OCI_PRIVATE_KEY_PATH=.secrets/oci_api_key.pem