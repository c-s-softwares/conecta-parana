# Database
DATABASE_URL=postgresql://user:password@localhost:5432/conecta_parana?schema=public

# Server
PORT=3000
NODE_ENV=development

# Security
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
CORS_ORIGIN=http://localhost:4200,https://admin.conecta.com,https://app.conecta.com,http://localhost:3000

# Redis (cache)
REDIS_URL=redis://localhost:6379

# GlitchTip — APM / Error Tracking
# DSN gerado no dashboard do GlitchTip (ver docs/GLITCHTIP_SETUP.md)
GLITCHTIP_DSN=

# Secrets
JWT_SECRET=minha_chave_secreta_local
JWT_REFRESH_SECRET=minha_chave_refresh_local

# Seed de super admin (usado em backend/prisma/seed-admin.ts)
ADMIN_SEED_EMAIL=admin@conecta.local
ADMIN_SEED_PASSWORD=admin123
ADMIN_SEED_NAME=Admin

# Storage de arquivos
# - local (padrão em dev): persiste em backend/.local-uploads/ e serve via
#   GET /dev-uploads/...  Não precisa de credenciais Oracle.
# - oci: usa Oracle Object Storage (preencher as OCI_* abaixo).
STORAGE_DRIVER=local

# Oracle Object Storage (obrigatorias apenas quando STORAGE_DRIVER=oci)
OCI_OBJECT_STORAGE_NAMESPACE=
OCI_BUCKET_NAME=
OCI_REGION=
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY_PATH=

# Email transacional
# - mock (padrão em dev): loga no console sem enviar emails reais.
# - resend: usa Resend (preencher RESEND_API_KEY e MAIL_FROM abaixo).
MAIL_DRIVER=mock

# Resend (obrigatórias apenas quando MAIL_DRIVER=resend)
RESEND_API_KEY=
MAIL_FROM=noreply@conectaparana.com