# == PLATAFORMAS NAO SUPORTADAS =========================================================
# Este app tem como alvo apenas Android e iOS.
# As pastas abaixo sao geradas pelo Flutter e nao devem ser rastreadas.

windows/
web/
linux/
macos/

# == DART ===============================================================================

# Pub package manager
.dart_tool/
.packages
.pub-cache/
.pub/

# Dart generated files (JS targets)
*.dart.js
*.info.json
*.js_
*.js.deps
*.js.map

# Dartdoc
doc/api/
**/doc/api/

# == FLUTTER ============================================================================

# Plugin registrants (gerados automaticamente)
lib/generated_plugin_registrant.dart
**/linux/flutter/generated_plugin_registrant.cc
**/linux/flutter/generated_plugins.cmake
**/windows/flutter/generated_plugin_registrant.cc
**/windows/flutter/generated_plugins.cmake
**/macos/Flutter/GeneratedPluginRegistrant.swift

# Flutter tool cache
.flutter-plugins
.flutter-plugins-dependencies

# FVM (Flutter Version Management)
.fvm/flutter_sdk

# Coverage
coverage/

# pubspec.lock — descomente se for biblioteca (package), mantenha commitado se for app
# pubspec.lock

# Arquivos gerados por code generation (Freezed, json_serializable, etc.)
# ATENÇÃO: Avalie o tradeoff antes de descomentar:
#   - Descomentar: menos ruído em PRs, mas exige que o CI rode o build_runner
#   - Comentado (padrão): arquivos commitados, onboarding mais simples e CI mais rápido
# *.g.dart
# *.freezed.dart
# *.gen.dart

# == ANDROID ============================================================================

# Gradle
.gradle/
build/
/android/app/debug
/android/app/profile
/android/app/release

# Gradle wrapper (manter o jar garante versão consistente no CI)
**/android/.gradle
**/android/**/gradle-wrapper.jar
# **/android/gradlew       # *** mantenha commitado para consistência no CI ***
# **/android/gradlew.bat   # *** mantenha commitado para consistência no CI ***

# Configuração local (SDK path, etc.)
local.properties
**/android/local.properties
/*/local.properties

# Configurações de assinatura — NUNCA commitar
*.jks
*.keystore
**/android/key.properties
.signing/

# Google Services — NUNCA commitar
google-services.json

# Arquivos gerados pelo Android Studio / AGP
captures/
.externalNativeBuild/
.cxx/
/android/gen/
/android/out/
obj/
gen-external-apklibs

# Binários compilados
*.apk
*.aab
*.ap_
*.dex
*.class
output.json

# Profiling
*.hprof

# ProGuard
proguard/

# NDK / CMake
*.so

# Log
*.log

